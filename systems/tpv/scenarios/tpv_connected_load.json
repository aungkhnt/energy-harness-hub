{
  "schema_version": "0.1.0",
  "study_id": "tpv-connected-load",
  "domain": "electrical_dc",
  "nodes": [
    "ground",
    "cell_bus",
    "load_bus"
  ],
  "reference_node": "ground",
  "assumptions": [
    "Illustrative fixed-temperature TPV cell connected directly to a resistive load through a resistive lead.",
    "No MPPT, conditioning, auxiliary demand or heat-balance solution is included. Device calibration is deferred."
  ],
  "modules": [
    {
      "id": "cell",
      "type": "tpv_cell",
      "positive": "cell_bus",
      "negative": "ground",
      "parameters": {
        "tpv_parameters": {
          "emitter_temperature_k": 2000,
          "cell_temperature_k": 300,
          "emissivity": 0.9,
          "emitter_width_m": 0.05,
          "emitter_height_m": 0.05,
          "cell_width_m": 0.02,
          "cell_height_m": 0.02,
          "gap_m": 0.1,
          "emitter_offset_x_m": 0,
          "emitter_offset_y_m": 0,
          "bandgap_ev": 0.7,
          "external_quantum_efficiency": 0.8,
          "dark_saturation_current_density_a_m2": 0.01,
          "conditioning_efficiency": 1,
          "auxiliary_power_w": 0
        }
      }
    },
    {
      "id": "lead",
      "type": "resistor",
      "positive": "cell_bus",
      "negative": "load_bus",
      "parameters": {
        "resistance_ohm": 0.005
      }
    },
    {
      "id": "load",
      "type": "resistor",
      "positive": "load_bus",
      "negative": "ground",
      "parameters": {
        "resistance_ohm": 0.05
      }
    }
  ]
}
